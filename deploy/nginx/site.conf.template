server {
    listen 80;
    server_name ${DOMAIN};
    access_log off;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://${DOMAIN}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    access_log off;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 1g;

    # Internal APIs are available only on the private Compose networks.
    location ^~ /api/internal/ { return 404; }
    location ^~ /_protected/downloads/ {
        internal;
        alias /data/downloads/;
        disable_symlinks on;
        autoindex off;
        add_header Cache-Control "private, no-store" always;
    }
    location ^~ /_protected/share/ {
        internal;
        alias /data/share/;
        disable_symlinks on;
        autoindex off;
        add_header Cache-Control "private, no-store" always;
    }
    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $application http://web:3000;
        proxy_pass $application;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
    }
}
