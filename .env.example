# Keep the real file outside Git; chmod 600 .env. Secrets: openssl rand -hex 32.
DOMAIN=duck.example.com
ORIGIN=https://duck.example.com
BETTER_AUTH_URL=https://duck.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_API_SECRET=replace-with-another-32-random-bytes
POSTGRES_PASSWORD=replace-with-random-hex-no-url-special-characters
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-random-hex-secret
DATABASE_URL=postgresql://duck:replace-with-random-hex-no-url-special-characters@postgres:5432/duck
QBT_URL=http://qbittorrent:8080
QBT_USERNAME=duck-rpc
QBT_PASSWORD=replace-with-another-long-random-secret
DOWNLOADS_DIR=/data/downloads
SHARE_DIR=/data/share
STUDIO_DIR=/data/studio
DATA_ROOT=/srv/torrentduck
PUBLIC_IPV4=203.0.113.10
ACME_EMAIL=admin@example.com
# This email becomes admin on signup, with access after email verification.
# Leave empty to disable automatic admin signup.
ADMIN_EMAIL=
# Mailgun sends password-reset and email-verification messages.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=TorrentsDuck2 <noreply@example.com>
# Use https://api.eu.mailgun.net for a domain hosted in the EU.
MAILGUN_API_URL=https://api.mailgun.net
# Optional SMTP fallback when MAILGUN_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TorrentsDuck2 <noreply@example.com>

# Optional daily encrypted FTP backup. Keep the private age identity off the server.
BACKUP_FTP_ENABLED=false
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=
BACKUP_FTP_TLS=false
BACKUP_FTP_DIRECTORY=torrents-duck
BACKUP_AGE_RECIPIENT=
# Total bytes available to this backup directory; one extra copy is reserved for uploads.
# PostgreSQL/configuration first, then all regular share files, smallest first.
BACKUP_FTP_QUOTA_BYTES=100000000000
BACKUP_FTP_KEEP=1
